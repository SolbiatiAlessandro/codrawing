# Slim player-only image for full agent-harness seats.
# Softmax limits player images to 512 MiB, so this image contains only the
# player code, Node, and Claude Code - no game server, onnx, or torch.

FROM docker.io/library/node:22-slim AS harness
RUN npm install -g @anthropic-ai/claude-code && npm cache clean --force

FROM docker.io/library/python:3.12-slim
RUN pip install --no-cache-dir websockets==15.0.1
COPY --from=harness /usr/local/bin/node /usr/local/bin/node
COPY --from=harness /usr/local/lib/node_modules/@anthropic-ai/claude-code \
    /usr/local/lib/node_modules/@anthropic-ai/claude-code
RUN ln -s /usr/local/lib/node_modules/@anthropic-ai/claude-code/cli.js /usr/local/bin/claude \
    && chmod +x /usr/local/lib/node_modules/@anthropic-ai/claude-code/cli.js

ENV PYTHONPATH=/app
WORKDIR /app
COPY codrawing /app/codrawing

CMD ["python", "-m", "codrawing.player.agent_player"]
