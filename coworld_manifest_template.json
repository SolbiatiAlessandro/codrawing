{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/coworld/main/src/coworld/coworld_manifest_schema.json",
  "tags": [
    "cooperative",
    "turn-based",
    "pixel-art"
  ],
  "game": {
    "name": "codrawing",
    "description": "Five agents coordinate through one public message and one pixel per turn to draw a shared target. Every turn, a small frozen ImageNet classifier returns shared feedback; a human can also judge the replay.",
    "owner": "Alessandro",
    "runnable": {
      "type": "game",
      "image": "{{CODRAWING_IMAGE}}",
      "run": [
        "python",
        "-m",
        "codrawing.game.server"
      ],
      "source_url": "https://github.com/SolbiatiAlessandro/codrawing"
    },
    "config_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "players",
        "width",
        "height",
        "max_turns",
        "targets"
      ],
      "properties": {
        "tokens": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "players": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "width": {
          "type": "integer",
          "minimum": 8,
          "maximum": 64
        },
        "height": {
          "type": "integer",
          "minimum": 8,
          "maximum": 64
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "cat",
              "dog",
              "elephant"
            ]
          }
        },
        "seed": {
          "type": "integer"
        },
        "player_connect_timeout_seconds": {
          "type": "number",
          "minimum": 0,
          "default": 30
        },
        "action_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120,
          "default": 15
        }
      }
    },
    "results_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "$defs": {
        "prediction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "probability"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "probability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "image_model_feedback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "turn",
            "target_score",
            "score_delta",
            "pass_threshold",
            "passing",
            "target_rank",
            "best_target_label",
            "top_predictions"
          ],
          "properties": {
            "model": {
              "type": "string",
              "const": "squeezenet1_1_imagenet1k_v1"
            },
            "turn": {
              "type": "integer",
              "minimum": 0
            },
            "target_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "score_delta": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "pass_threshold": {
              "type": "number",
              "const": 0.5
            },
            "passing": {
              "type": "boolean"
            },
            "target_rank": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "best_target_label": {
              "type": "string"
            },
            "top_predictions": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "$ref": "#/$defs/prediction"
              }
            }
          }
        }
      },
      "required": [
        "scores",
        "target",
        "turns",
        "accepted_pixels",
        "final_canvas",
        "image_model",
        "evaluation_threshold",
        "evaluation_passed",
        "final_image_model_feedback",
        "image_model_score_trace"
      ],
      "properties": {
        "scores": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "number"
          }
        },
        "target": {
          "type": "string",
          "enum": [
            "cat",
            "dog",
            "elephant"
          ]
        },
        "turns": {
          "type": "integer",
          "minimum": 1
        },
        "accepted_pixels": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "final_canvas": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[0-9A-F]{6}$"
          }
        },
        "image_model": {
          "type": "string",
          "const": "squeezenet1_1_imagenet1k_v1"
        },
        "evaluation_threshold": {
          "type": "number",
          "const": 0.5
        },
        "evaluation_passed": {
          "type": "boolean"
        },
        "final_image_model_feedback": {
          "$ref": "#/$defs/image_model_feedback"
        },
        "image_model_score_trace": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/image_model_feedback"
          }
        }
      }
    },
    "protocols": {
      "player": {
        "type": "uri",
        "value": "https://github.com/SolbiatiAlessandro/codrawing/blob/main/docs/player-protocol.md"
      },
      "global": {
        "type": "uri",
        "value": "https://github.com/SolbiatiAlessandro/codrawing/blob/main/docs/global-protocol.md"
      }
    },
    "docs": {
      "readme": {
        "type": "uri",
        "value": "https://github.com/SolbiatiAlessandro/codrawing/blob/main/README.md"
      }
    }
  },
  "player": [
    {
      "id": "template-team-player",
      "name": "Template Team Player",
      "type": "player",
      "image": "{{CODRAWING_IMAGE}}",
      "run": [
        "python",
        "-m",
        "codrawing.player.template_player"
      ],
      "source_url": "https://github.com/SolbiatiAlessandro/codrawing/tree/main/codrawing/player",
      "description": "Deterministic no-LLM baseline that divides a small target template across the five seats."
    }
  ],
  "variants": [
    {
      "id": "human-review",
      "name": "Human review",
      "description": "A 24x24, five-agent episode with a small shared image classifier reporting progress every turn.",
      "game_config": {
        "width": 24,
        "height": 24,
        "max_turns": 50,
        "targets": [
          "cat",
          "dog",
          "elephant"
        ],
        "player_connect_timeout_seconds": 120,
        "action_timeout_seconds": 60,
        "players": [
          {
            "name": "Artist 1"
          },
          {
            "name": "Artist 2"
          },
          {
            "name": "Artist 3"
          },
          {
            "name": "Artist 4"
          },
          {
            "name": "Artist 5"
          }
        ]
      }
    }
  ],
  "certification": {
    "game_config": {
      "width": 24,
      "height": 24,
      "max_turns": 8,
      "targets": [
        "cat"
      ],
      "seed": 1,
      "player_connect_timeout_seconds": 120,
      "action_timeout_seconds": 2,
      "players": [
        {
          "name": "Artist 1"
        },
        {
          "name": "Artist 2"
        },
        {
          "name": "Artist 3"
        },
        {
          "name": "Artist 4"
        },
        {
          "name": "Artist 5"
        }
      ]
    },
    "players": [
      {
        "player_id": "template-team-player"
      },
      {
        "player_id": "template-team-player"
      },
      {
        "player_id": "template-team-player"
      },
      {
        "player_id": "template-team-player"
      },
      {
        "player_id": "template-team-player"
      }
    ]
  }
}
